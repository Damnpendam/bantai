# Copy to .env.local for local development, or set these in your host's
# dashboard. Only APP_SECRET, APP_URL, SUPERADMIN_EMAIL and BANTAI_DATA_DIR
# matter for a first deploy; everything else is optional.

# --- Required in production ----------------------------------------------------

# Encrypts stored provider API keys at rest. 32+ characters.
#   openssl rand -base64 48
# Changing it later makes already-stored keys unreadable (users re-enter them).
APP_SECRET=

# Public URL of this deployment, used to build invite and reset links.
APP_URL=https://bantai.example.com

# Who becomes the first super admin. Until that account exists, every server
# start emails this address a one-time setup link (and prints it to the log).
SUPERADMIN_EMAIL=you@example.com

# Where the SQLite database lives. Point this at a persistent volume.
BANTAI_DATA_DIR=/data

# --- Email (optional) ------------------------------------------------------------
# Without these, invites and resets aren't emailed; the admin page shows the
# invite link to copy and pass on by hand.
RESEND_API_KEY=
EMAIL_FROM="Bantai <invites@your-domain.com>"

# --- Shared model key (optional) -------------------------------------------------
# Lets workspaces with no key of their own try the app on yours, on the model
# you choose, capped per workspace per day.
PLATFORM_API_KEY=
PLATFORM_PROVIDER=openrouter
PLATFORM_MODEL=
PLATFORM_EFFORT=low
PLATFORM_CONCURRENCY=2
PLATFORM_DAILY_RUNS=3
PLATFORM_DAILY_INGESTS=10

# --- Limits --------------------------------------------------------------------
# Concurrently executing run stages across all workspaces on this server.
MAX_ACTIVE_RUNS=4
MAX_PROJECTS_PER_WORKSPACE=50

# Set to false only to try a production build over plain http locally.
# COOKIE_SECURE=false
